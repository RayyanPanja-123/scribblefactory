{
  "$defs": {
    "CustomSet": {
      "additionalProperties": false,
      "properties": {
        "back": {
          "description": "indoor: the back wall; outdoor: the sky",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Back",
          "type": "string"
        },
        "floor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Floor",
          "type": "string"
        },
        "id": {
          "description": "the name used in @set",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "indoor: floor and back wall; outdoor: wide floor and sky, allows travel shots",
          "enum": [
            "indoor",
            "outdoor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pieces": {
          "default": [],
          "description": "drawn in order",
          "items": {
            "$ref": "#/$defs/SetPiece"
          },
          "maxItems": 60,
          "title": "Pieces",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "floor",
        "back"
      ],
      "title": "CustomSet",
      "type": "object"
    },
    "SetPiece": {
      "additionalProperties": false,
      "description": "one primitive of a custom set, in world units: actors stand on y = 0, z = 0, x in -2..2; the back wall of an\nindoor set is at z -2.6. Anything across the stage (|x| < 2.2) must sit behind z -1, nothing forward of z 0.6\n(the engine checks this stage clearance when it builds the set).",
      "properties": {
        "at": {
          "description": "the centre",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "backdrop": {
          "default": false,
          "description": "scenery that is never hidden behind an actor (walls, far hills)",
          "title": "Backdrop",
          "type": "boolean"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "outline": {
          "default": true,
          "title": "Outline",
          "type": "boolean"
        },
        "shape": {
          "enum": [
            "box",
            "cyl",
            "ball",
            "mound"
          ],
          "title": "Shape",
          "type": "string"
        },
        "size": {
          "description": "box: width, height, depth; cyl: top radius, bottom radius, height; ball: radius; mound: radius, height factor",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Size",
          "type": "array"
        }
      },
      "required": [
        "shape",
        "at",
        "size",
        "color"
      ],
      "title": "SetPiece",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CustomSet"
      },
      "title": "Sets",
      "type": "array"
    }
  },
  "title": "SetLibrary",
  "type": "object"
}
