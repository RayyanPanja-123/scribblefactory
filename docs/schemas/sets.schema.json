{
  "$defs": {
    "CustomSet": {
      "additionalProperties": false,
      "properties": {
        "back": {
          "description": "indoor: the back wall; outdoor: the sky",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Back",
          "type": "string"
        },
        "default_weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weather"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "weather each @set of this set starts with (until an @weather); none: clear"
        },
        "floor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Floor",
          "type": "string"
        },
        "id": {
          "description": "the name used in @set",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "indoor: floor and back wall; outdoor: wide floor and sky, allows travel shots",
          "enum": [
            "indoor",
            "outdoor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "objects": {
          "default": [],
          "description": "placed World Objects, targetable by staged interactions",
          "items": {
            "$ref": "#/$defs/WorldObjectInstance"
          },
          "maxItems": 60,
          "title": "Objects",
          "type": "array"
        },
        "pieces": {
          "default": [],
          "description": "drawn in order",
          "items": {
            "$ref": "#/$defs/SetPiece"
          },
          "maxItems": 60,
          "title": "Pieces",
          "type": "array"
        },
        "trail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trail"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stairs or a slope a character can `@do climb` (draw the steps as pieces; walk in front of them, z in front of the steps' face); none: nothing to climb here"
        },
        "use_for": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when a story should use it (shown to the story AI; never changes the drawing)",
          "title": "Use For"
        },
        "water": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outdoor: the floor is a sea or lake (waves, foam, ripples, reflections); none: when the floor colour reads blue",
          "title": "Water"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "floor",
        "back"
      ],
      "title": "CustomSet",
      "type": "object"
    },
    "SetPiece": {
      "additionalProperties": false,
      "description": "one primitive of a custom set, in world units: actors stand on y = 0, z = 0, x in -2..2; the back wall of an\nindoor set is at z -2.6. Anything across the stage (|x| < 2.2) must sit behind z -1, nothing forward of z 0.6\n(the engine checks this stage clearance when it builds the set).",
      "properties": {
        "at": {
          "description": "the centre",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "backdrop": {
          "default": false,
          "description": "scenery that is never hidden behind an actor (walls, far hills)",
          "title": "Backdrop",
          "type": "boolean"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "outline": {
          "default": true,
          "title": "Outline",
          "type": "boolean"
        },
        "shape": {
          "enum": [
            "box",
            "cyl",
            "ball",
            "mound"
          ],
          "title": "Shape",
          "type": "string"
        },
        "size": {
          "description": "box: width, height, depth; cyl: top radius, bottom radius, height; ball: radius; mound: radius, height factor",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Size",
          "type": "array"
        }
      },
      "required": [
        "shape",
        "at",
        "size",
        "color"
      ],
      "title": "SetPiece",
      "type": "object"
    },
    "Trail": {
      "additionalProperties": false,
      "description": "the path a `@do <cast>: climb` follows on a set: stairs or a slope, from its foot to its top",
      "properties": {
        "end": {
          "description": "[x, y, z] of the top; its y is higher than the foot's, x differs from the foot's",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "start": {
          "description": "[x, y, z] of the foot: where a climb up starts (a climb down ends here)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "steps": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stairs: the height rises in this many steps; none: a smooth slope",
          "title": "Steps"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Trail",
      "type": "object"
    },
    "Weather": {
      "additionalProperties": false,
      "description": "scene weather, drawn in ink by the engine (weather.js): fog behind the cast, the rest in front",
      "properties": {
        "intensity": {
          "default": "medium",
          "enum": [
            "light",
            "medium",
            "heavy"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rain",
            "snow",
            "fog",
            "wind",
            "storm"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Weather",
      "type": "object"
    },
    "WorldObjectInstance": {
      "additionalProperties": false,
      "description": "A named placement of a WorldObject in a set; its id is the story target. A card stands on `at` (its base);\na sky / back card's base is its middle.",
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "card: $accent (none: the drawing's own)",
          "title": "Accent"
        },
        "at": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "at_wide": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where it stands in a 16:9 frame (a wider view: spread it out); none: at",
          "title": "At Wide"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "card: $main (none: the drawing's own)",
          "title": "Color"
        },
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "object": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Object",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "card: its state here (none: its first)",
          "title": "State"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "object",
        "at"
      ],
      "title": "WorldObjectInstance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CustomSet"
      },
      "title": "Sets",
      "type": "array"
    }
  },
  "title": "SetLibrary",
  "type": "object"
}
