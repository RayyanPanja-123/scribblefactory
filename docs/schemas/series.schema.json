{
  "$defs": {
    "CastLook": {
      "additionalProperties": false,
      "description": "a named variant of a cast member's look (story: @look <cast>: <name>). Only what it sets changes; everything\nelse stays the cast member's own. The character keeps its id, name, approval and drawing seed.",
      "properties": {
        "accessory": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WardrobeSlot"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: unchanged; []: none",
          "title": "Accessory"
        },
        "back": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_expression": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "happy",
                "cheer",
                "sad",
                "angry",
                "surprised",
                "sleepy",
                "cheeky",
                "exhausted",
                "worried",
                "dead",
                "smug",
                "proud",
                "love",
                "excited",
                "relieved",
                "laughing",
                "wink",
                "furious",
                "annoyed",
                "disgusted",
                "crying",
                "scared",
                "embarrassed",
                "jealous",
                "guilty",
                "confused",
                "thinking",
                "suspicious",
                "shocked",
                "deadpan",
                "bored",
                "facepalm_ready",
                "dizzy",
                "drunk",
                "knocked_out",
                "evil",
                "crazy",
                "blank",
                "sick",
                "determined"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Expression"
        },
        "eyes": {
          "anyOf": [
            {
              "enum": [
                "dots",
                "half_closed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eyes"
        },
        "face": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WardrobeSlot"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face"
        },
        "facial_hair": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flame": {
          "anyOf": [
            {
              "enum": [
                "off",
                "low",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: unchanged. non-humanoid creatures only: fire on the mane, tail and hooves, eyes glowing (off | low | high). Left out of the saved file when unset, so older casts and their approvals stay as they were",
          "title": "Flame"
        },
        "flame_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: unchanged. the flame's outer colour; the middle layer and the core (and the glowing eyes) are lighter mixes of it. Unset: fire (red, orange, yellow core)",
          "title": "Flame Color"
        },
        "footwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hair": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: unchanged; \"none\": taken off"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "creatures with a stump only",
          "title": "Headless"
        },
        "headwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/Headwear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "legwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/Legwear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "props": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Prop"
              },
              "maxItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "held props, one per hand ([]: none)",
          "title": "Props"
        },
        "top": {
          "anyOf": [
            {
              "$ref": "#/$defs/Top"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CastLook",
      "type": "object"
    },
    "CastMember": {
      "additionalProperties": false,
      "properties": {
        "accessory": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WardrobeSlot"
          },
          "maxItems": 3,
          "title": "Accessory",
          "type": "array"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "back": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body": {
          "default": "human",
          "description": "creature id (built in or library/creatures.json). human (default) and other humanoids are stickmen: face, expressions, costume. Other rigs are drawn in top.color ($main) and top.accent_color ($accent), eyes and mouth only, no costume",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Body",
          "type": "string"
        },
        "default_expression": {
          "default": "neutral",
          "enum": [
            "neutral",
            "happy",
            "cheer",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted",
            "worried",
            "dead",
            "smug",
            "proud",
            "love",
            "excited",
            "relieved",
            "laughing",
            "wink",
            "furious",
            "annoyed",
            "disgusted",
            "crying",
            "scared",
            "embarrassed",
            "jealous",
            "guilty",
            "confused",
            "thinking",
            "suspicious",
            "shocked",
            "deadpan",
            "bored",
            "facepalm_ready",
            "dizzy",
            "drunk",
            "knocked_out",
            "evil",
            "crazy",
            "blank",
            "sick",
            "determined"
          ],
          "title": "Default Expression",
          "type": "string"
        },
        "eyes": {
          "enum": [
            "dots",
            "half_closed"
          ],
          "title": "Eyes",
          "type": "string"
        },
        "face": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WardrobeSlot"
          },
          "maxItems": 3,
          "title": "Face",
          "type": "array"
        },
        "facial_hair": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flame": {
          "anyOf": [
            {
              "enum": [
                "off",
                "low",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: off. non-humanoid creatures only: fire on the mane, tail and hooves, eyes glowing (off | low | high). Left out of the saved file when unset, so older casts and their approvals stay as they were",
          "title": "Flame"
        },
        "flame_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the flame's outer colour; the middle layer and the core (and the glowing eyes) are lighter mixes of it. Unset: fire (red, orange, yellow core)",
          "title": "Flame Color"
        },
        "footwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hair": {
          "anyOf": [
            {
              "$ref": "#/$defs/WardrobeSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "wardrobe slots: an id, {\"id\", \"color\"} or null"
        },
        "headless": {
          "default": false,
          "description": "creatures with a stump only: the stump instead of the head",
          "title": "Headless",
          "type": "boolean"
        },
        "headwear": {
          "$ref": "#/$defs/Headwear",
          "default": {
            "color": null,
            "kind": "none"
          }
        },
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "legwear": {
          "$ref": "#/$defs/Legwear",
          "default": {
            "color": null,
            "kind": "none"
          }
        },
        "looks": {
          "default": {},
          "description": "named variants a story switches to with @look <cast>: <name> (default: back to this entry's own)",
          "patternProperties": {
            "^[a-z0-9]+(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/CastLook"
            }
          },
          "title": "Looks",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "props": {
          "default": [],
          "description": "held props, one per hand",
          "items": {
            "$ref": "#/$defs/Prop"
          },
          "maxItems": 2,
          "title": "Props",
          "type": "array"
        },
        "top": {
          "$ref": "#/$defs/Top",
          "default": {
            "accent_color": null,
            "color": null,
            "number": null,
            "style": "plain"
          }
        },
        "voice": {
          "anyOf": [
            {
              "$ref": "#/$defs/TtsVoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the TTS voice of this member's spoken lines (`<id>: line` in story.md) in parts with voice_source tts. Left out of the saved file when unset; never part of the look (no new approval)"
        }
      },
      "required": [
        "id",
        "name",
        "eyes"
      ],
      "title": "CastMember",
      "type": "object"
    },
    "Headwear": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "description": "wardrobe id (\"id\" or a plain string accepted too): built in flat_cap, postman_cap, bowler, straw_hat, wide_hat, or a library headwear; none",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Headwear",
      "type": "object"
    },
    "Legwear": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "description": "wardrobe id: built in shorts, ragged_shorts, trousers, or a library legwear; none",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Legwear",
      "type": "object"
    },
    "Prop": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "anyOf": [
            {
              "description": "degrees the held prop leans, like a clock hand with the top tipped away from the body: 0 upright, 90 level, 75 = half past two in the right hand",
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "this character's own angle; null: the prop's",
          "title": "Angle"
        },
        "hand": {
          "default": "right",
          "enum": [
            "left",
            "right"
          ],
          "title": "Hand",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Prop",
      "type": "object"
    },
    "Style": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "default": "9:16",
          "enum": [
            "9:16",
            "16:9"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "captions": {
          "default": true,
          "title": "Captions",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "preset": {
          "title": "Preset",
          "type": "string"
        }
      },
      "required": [
        "preset"
      ],
      "title": "Style",
      "type": "object"
    },
    "Top": {
      "additionalProperties": false,
      "properties": {
        "accent_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "suit: the tie colour (no tie when null); dress: the wide hat's ribbon and flower; a library top: its $accent layers",
          "title": "Accent Color"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "none: the cast member's own top colour in a look, else the default top colour",
          "title": "Color"
        },
        "number": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chest number on a white bib",
          "title": "Number"
        },
        "style": {
          "default": "plain",
          "description": "the top's wardrobe id (\"id\" accepted too): built in plain, suit, tank, shirt, dress, or a library top",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Style",
          "type": "string"
        }
      },
      "title": "Top",
      "type": "object"
    },
    "TtsVoice": {
      "additionalProperties": false,
      "description": "a voice on the Kokoro TTS server (settings tts_url): its id and speaking speed",
      "properties": {
        "id": {
          "description": "Kokoro voice id, e.g. am_michael (settings tts_voices)",
          "maxLength": 60,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.5,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "TtsVoice",
      "type": "object"
    },
    "Voice": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "pronunciations": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Pronunciations",
          "type": "object"
        },
        "provider": {
          "default": "freetts.ai",
          "title": "Provider",
          "type": "string"
        },
        "tts": {
          "anyOf": [
            {
              "$ref": "#/$defs/TtsVoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the narrator's TTS voice for parts with voice_source tts (none: settings tts_voice)"
        },
        "voice_name": {
          "title": "Voice Name",
          "type": "string"
        }
      },
      "required": [
        "voice_name"
      ],
      "title": "Voice",
      "type": "object"
    },
    "WardrobeSlot": {
      "additionalProperties": false,
      "description": "one worn wardrobe item: an id (built in or library/wardrobe.json) and an optional colour for colorable items.\nA plain id string is accepted. \"none\": nothing (in a look: takes the cast member's item off).",
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "id": {
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "WardrobeSlot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cast": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CastMember"
      },
      "title": "Cast",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "parts": {
      "default": [],
      "items": {
        "pattern": "^part-[0-9]{2}$",
        "type": "string"
      },
      "title": "Parts",
      "type": "array"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "active",
        "complete",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "style": {
      "$ref": "#/$defs/Style"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "voice": {
      "$ref": "#/$defs/Voice"
    }
  },
  "required": [
    "slug",
    "title",
    "created_at",
    "voice",
    "style"
  ],
  "title": "SeriesModel",
  "type": "object"
}
