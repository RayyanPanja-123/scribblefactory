{
  "$defs": {
    "CastMember": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "default_expression": {
          "default": "neutral",
          "enum": [
            "neutral",
            "happy",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted"
          ],
          "title": "Default Expression",
          "type": "string"
        },
        "eyes": {
          "enum": [
            "dots",
            "half_closed"
          ],
          "title": "Eyes",
          "type": "string"
        },
        "headwear": {
          "$ref": "#/$defs/Headwear",
          "default": {
            "color": null,
            "kind": "none"
          }
        },
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "legwear": {
          "$ref": "#/$defs/Legwear",
          "default": {
            "color": null,
            "kind": "none"
          }
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "props": {
          "default": [],
          "description": "held props, one per hand",
          "items": {
            "$ref": "#/$defs/Prop"
          },
          "maxItems": 2,
          "title": "Props",
          "type": "array"
        },
        "top": {
          "$ref": "#/$defs/Top"
        }
      },
      "required": [
        "id",
        "name",
        "top",
        "eyes"
      ],
      "title": "CastMember",
      "type": "object"
    },
    "Headwear": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "enum": [
            "none",
            "flat_cap",
            "postman_cap",
            "bowler",
            "straw_hat",
            "wide_hat"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Headwear",
      "type": "object"
    },
    "Legwear": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "enum": [
            "none",
            "shorts",
            "ragged_shorts",
            "trousers"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Legwear",
      "type": "object"
    },
    "Prop": {
      "additionalProperties": false,
      "properties": {
        "hand": {
          "default": "right",
          "enum": [
            "left",
            "right"
          ],
          "title": "Hand",
          "type": "string"
        },
        "kind": {
          "enum": [
            "clipboard",
            "stopwatch",
            "bottle",
            "syringe",
            "apple",
            "medal"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Prop",
      "type": "object"
    },
    "Style": {
      "additionalProperties": false,
      "properties": {
        "captions": {
          "default": true,
          "title": "Captions",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "preset": {
          "title": "Preset",
          "type": "string"
        }
      },
      "required": [
        "preset"
      ],
      "title": "Style",
      "type": "object"
    },
    "Top": {
      "additionalProperties": false,
      "properties": {
        "accent_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "suit: the tie colour (no tie when null); dress: the wide hat's ribbon and flower",
          "title": "Accent Color"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chest number on a white bib",
          "title": "Number"
        },
        "style": {
          "default": "plain",
          "enum": [
            "plain",
            "suit",
            "tank",
            "shirt",
            "dress"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "color"
      ],
      "title": "Top",
      "type": "object"
    },
    "Voice": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "provider": {
          "default": "freetts.ai",
          "title": "Provider",
          "type": "string"
        },
        "voice_name": {
          "title": "Voice Name",
          "type": "string"
        }
      },
      "required": [
        "voice_name"
      ],
      "title": "Voice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cast": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CastMember"
      },
      "title": "Cast",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "parts": {
      "default": [],
      "items": {
        "pattern": "^part-[0-9]{2}$",
        "type": "string"
      },
      "title": "Parts",
      "type": "array"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "active",
        "complete",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "style": {
      "$ref": "#/$defs/Style"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "voice": {
      "$ref": "#/$defs/Voice"
    }
  },
  "required": [
    "slug",
    "title",
    "created_at",
    "voice",
    "style"
  ],
  "title": "SeriesModel",
  "type": "object"
}
