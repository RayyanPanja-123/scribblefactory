{
  "$defs": {
    "WardrobeItem": {
      "additionalProperties": false,
      "properties": {
        "colorable": {
          "default": true,
          "description": "the cast member's colour replaces default_color in $color",
          "title": "Colorable",
          "type": "boolean"
        },
        "default_accent": {
          "default": "#3a2a1e",
          "description": "$accent when the cast member sets no accent",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Default Accent",
          "type": "string"
        },
        "default_color": {
          "default": "#6b4f3a",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Default Color",
          "type": "string"
        },
        "id": {
          "description": "the id a cast slot uses",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layers": {
          "default": [],
          "description": "drawn in order: later ones on top",
          "items": {
            "$ref": "#/$defs/WardrobeLayer"
          },
          "maxItems": 60,
          "title": "Layers",
          "type": "array"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "slot": {
          "enum": [
            "hair",
            "facial_hair",
            "headwear",
            "top",
            "legwear",
            "footwear",
            "back",
            "accessory",
            "face"
          ],
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "slot"
      ],
      "title": "WardrobeItem",
      "type": "object"
    },
    "WardrobeLayer": {
      "additionalProperties": false,
      "description": "one ink shape of a wardrobe item, in canvas px around its anchor (the default human: head radius 150, body 184\nwide and 300 tall, legs 220, arms 175). x: across (+ outward on the paired anchors shoulders / arms / hands / legs /\nfeet, drawn on both sides, mirrored on the left); y: down (arms and legs: along the limb from the shoulder / hip).\nTorso anchors scale with body_w x body_h, arms and hands with arm, legs and feet with leg; head anchors (head,\nhead_top, face, eyes, mouth) are in head space: they scale with the head and turn with the face.",
      "properties": {
        "anchor": {
          "enum": [
            "head",
            "head_top",
            "face",
            "eyes",
            "mouth",
            "neck",
            "shoulders",
            "chest",
            "waist",
            "hips",
            "back",
            "arms",
            "hands",
            "legs",
            "feet"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "behind": {
          "default": false,
          "description": "drawn behind the head and body (long hair, a cape)",
          "title": "Behind",
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "enum": [
                "$color",
                "$accent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "$color: the worn colour (the cast member's for a colorable item, else the item's default_color); $accent: the worn accent (else default_accent); none: outline only. For a line: its colour (default ink)",
          "title": "Fill"
        },
        "pts": {
          "description": "rect: 2 corners; circle / ellipse: the centre; line: 2+ points; poly: 3+ points (closed)",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Pts",
          "type": "array"
        },
        "r": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 400,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "circle: radius; ellipse: x radius",
          "title": "R"
        },
        "rot": {
          "default": 0,
          "description": "ellipse: turn in degrees, clockwise",
          "maximum": 180,
          "minimum": -180,
          "title": "Rot",
          "type": "number"
        },
        "ry": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 400,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ellipse: y radius",
          "title": "Ry"
        },
        "shape": {
          "enum": [
            "rect",
            "circle",
            "ellipse",
            "line",
            "poly"
          ],
          "title": "Shape",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "neutral",
                  "happy",
                  "cheer",
                  "sad",
                  "angry",
                  "surprised",
                  "sleepy",
                  "cheeky",
                  "exhausted",
                  "worried",
                  "dead",
                  "smug",
                  "proud",
                  "love",
                  "excited",
                  "relieved",
                  "laughing",
                  "wink",
                  "furious",
                  "annoyed",
                  "disgusted",
                  "crying",
                  "scared",
                  "embarrassed",
                  "jealous",
                  "guilty",
                  "confused",
                  "thinking",
                  "suspicious",
                  "shocked",
                  "deadpan",
                  "bored",
                  "facepalm_ready",
                  "dizzy",
                  "drunk",
                  "knocked_out",
                  "evil",
                  "crazy",
                  "blank",
                  "sick",
                  "determined"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only with these expressions (blush: happy)",
          "title": "When"
        },
        "width": {
          "default": 8,
          "description": "outline / line width; 0: no outline",
          "maximum": 40,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "shape",
        "anchor",
        "pts"
      ],
      "title": "WardrobeLayer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "wardrobe": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WardrobeItem"
      },
      "title": "Wardrobe",
      "type": "array"
    }
  },
  "title": "WardrobeLibrary",
  "type": "object"
}
