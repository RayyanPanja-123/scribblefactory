{
  "$defs": {
    "CreatureFace": {
      "additionalProperties": false,
      "properties": {
        "eye": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "eye centre (head space; body space without a head): a dot that blinks",
          "title": "Eye"
        },
        "mouth": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mouth centre: opens while talking, hidden when shut",
          "title": "Mouth"
        }
      },
      "title": "CreatureFace",
      "type": "object"
    },
    "CreatureShape": {
      "additionalProperties": false,
      "description": "one piece of a creature part, in canvas px, facing right, y down: the body around the ground point under the\ncreature, every other part around its joint, at rest (legs and arms hang down from it). A stickman stands about\n950 px tall; the card is 1024 px wide (x -512..512) and tall (y -1000..24 for the body).",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "enum": [
                "$main",
                "$accent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "$main: the cast member's top colour; $accent: its accent colour (else the creature's); none: outline only. For a line: its colour (default ink)",
          "title": "Fill"
        },
        "pts": {
          "description": "rect: 2 corners; circle / ellipse: the centre; line: 2+ points; poly: 3+ points (closed)",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Pts",
          "type": "array"
        },
        "r": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "circle: radius; ellipse: x radius",
          "title": "R"
        },
        "rot": {
          "default": 0,
          "description": "ellipse: turn in degrees, clockwise",
          "maximum": 180,
          "minimum": -180,
          "title": "Rot",
          "type": "number"
        },
        "ry": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ellipse: y radius",
          "title": "Ry"
        },
        "shape": {
          "enum": [
            "rect",
            "circle",
            "ellipse",
            "line",
            "poly"
          ],
          "title": "Shape",
          "type": "string"
        },
        "width": {
          "default": 8,
          "description": "outline / line width; 0: no outline",
          "maximum": 40,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "shape",
        "pts"
      ],
      "title": "CreatureShape",
      "type": "object"
    },
    "CustomCreature": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "default": "#3a2a1e",
          "description": "$accent when the cast member has no accent colour",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanoidBuild"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "humanoid only: proportions and head colour"
        },
        "face": {
          "$ref": "#/$defs/CreatureFace",
          "default": {
            "eye": null,
            "mouth": null
          }
        },
        "id": {
          "description": "the body name used in series.json cast",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "joints": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "default": {},
          "description": "where each part attaches, ground space: hip, shoulder, neck, wing, tail (not for a humanoid)",
          "title": "Joints",
          "type": "object"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parts": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/CreatureShape"
            },
            "type": "array"
          },
          "default": {},
          "description": "part -> shapes, drawn in order (later on top; not for a humanoid)",
          "title": "Parts",
          "type": "object"
        },
        "rig": {
          "description": "how it moves: humanoid (a stickman: face, costume, hands), bird, quadruped, biped (has hands), crawler",
          "enum": [
            "humanoid",
            "bird",
            "quadruped",
            "biped",
            "crawler"
          ],
          "title": "Rig",
          "type": "string"
        },
        "use_for": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when a story should use it (shown to the story AI; never changes the drawing)",
          "title": "Use For"
        }
      },
      "required": [
        "id",
        "name",
        "rig"
      ],
      "title": "CustomCreature",
      "type": "object"
    },
    "HumanoidBuild": {
      "additionalProperties": false,
      "description": "a humanoid's proportions as factors of the stickman's (1 = the default human), and its head colour",
      "properties": {
        "arm": {
          "default": 1,
          "description": "arm length",
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Arm",
          "type": "number"
        },
        "body_h": {
          "default": 1,
          "description": "body height",
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Body H",
          "type": "number"
        },
        "body_w": {
          "default": 1,
          "description": "body width",
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Body W",
          "type": "number"
        },
        "head": {
          "default": 1,
          "description": "head size",
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Head",
          "type": "number"
        },
        "head_color": {
          "default": "#ffffff",
          "description": "head fill (skin)",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Head Color",
          "type": "string"
        },
        "leg": {
          "default": 1,
          "description": "leg length",
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Leg",
          "type": "number"
        }
      },
      "title": "HumanoidBuild",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "creatures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CustomCreature"
      },
      "title": "Creatures",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "CreatureLibrary",
  "type": "object"
}
