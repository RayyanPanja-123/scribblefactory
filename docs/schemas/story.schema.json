{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "a built-in action (ACTIONS: idle, walk, run, talk, point, react, wave, ride, stagger, lie, collapse, eat, give, receive, carry, carried, support, supported, cheer, angry, gasp) or a custom one from library/actions.json",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Action",
          "type": "string"
        },
        "approach": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "an item action after a walk to the item: the share of the shot the walk (start_pos to end_pos) takes; the action plays after",
          "title": "Approach"
        },
        "behind": {
          "default": [],
          "description": "an approach walk passes behind the actors standing at these x (a dip in z around each; engine actions.js passBehind)",
          "items": {
            "type": "number"
          },
          "title": "Behind",
          "type": "array"
        },
        "cast_id": {
          "title": "Cast Id",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "end_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "height at the end of the shot; none: the same as start_y",
          "title": "End Y"
        },
        "expression": {
          "description": "neutral: the cast member's default_expression",
          "enum": [
            "neutral",
            "happy",
            "cheer",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted",
            "worried",
            "dead",
            "smug",
            "proud",
            "love",
            "excited",
            "relieved",
            "laughing",
            "wink",
            "furious",
            "annoyed",
            "disgusted",
            "crying",
            "scared",
            "embarrassed",
            "jealous",
            "guilty",
            "confused",
            "thinking",
            "suspicious",
            "shocked",
            "deadpan",
            "bored",
            "facepalm_ready",
            "dizzy",
            "drunk",
            "knocked_out",
            "evil",
            "crazy",
            "blank",
            "sick",
            "determined"
          ],
          "title": "Expression",
          "type": "string"
        },
        "faces": {
          "default": [],
          "description": "face changes inside the shot, in frame order: expression until the first, then each from its frame",
          "items": {
            "$ref": "#/$defs/FaceChange"
          },
          "title": "Faces",
          "type": "array"
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "camera"
          ],
          "title": "Facing",
          "type": "string"
        },
        "item": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pickup / drop / open / close / push / sit / stand / enter / exit: the @item tag acted on (left out when none)",
          "title": "Item"
        },
        "look": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the cast member's named look (@look), none: its own",
          "title": "Look"
        },
        "mount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "@ride: the actor (a creature in this shot) this one rides; it is drawn in the saddle and goes where its mount goes",
          "title": "Mount"
        },
        "prop": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "eat / give: the prop eaten / handed over",
          "title": "Prop"
        },
        "props": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Prop"
              },
              "maxItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "@hold: the props held from this shot on (the look's, with held hands replaced); none: the look's own",
          "title": "Props"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "start_y": {
          "default": 0.0,
          "description": "height of the card above the ground at the start of the shot (climbing a set's trail: @do climb; 0 on the ground)",
          "title": "Start Y",
          "type": "number"
        },
        "steps": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stairs: the height rises in this many steps over the move (none: a smooth slope)",
          "title": "Steps"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "give / receive: the other actor; carry / support: the actor carried / supported",
          "title": "Target"
        },
        "wear": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "don: the wardrobe item (headwear or back) put on halfway through the shot; every later shot of the part has it on from the start",
          "title": "Wear"
        }
      },
      "required": [
        "cast_id",
        "action",
        "start_pos",
        "facing",
        "expression"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Animal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "run",
            "idle",
            "bark"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "dog",
          "title": "Kind",
          "type": "string"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "variant": {
          "enum": [
            "brown",
            "black",
            "tan",
            "white_patches"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Animal",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "wide",
            "medium",
            "close",
            "low",
            "high",
            "over_shoulder"
          ],
          "title": "Angle",
          "type": "string"
        },
        "dutch_deg": {
          "default": 0,
          "description": "@cam dutch: a tilted horizon (degrees, + rolls clockwise); glides in on a twist shot",
          "maximum": 25,
          "minimum": -25,
          "title": "Dutch Deg",
          "type": "number"
        },
        "forced": {
          "default": false,
          "description": "set by @cam: the validator lets its angle repeat the previous shot's and a twist keep @cam's move / dutch",
          "title": "Forced",
          "type": "boolean"
        },
        "move": {
          "anyOf": [
            {
              "enum": [
                "push_in",
                "pull_out",
                "truck_left",
                "truck_right",
                "crane_up",
                "crane_down",
                "orbit_left",
                "orbit_right"
              ],
              "type": "string"
            },
            {
              "const": "hold",
              "type": "string"
            }
          ],
          "description": "hold: no move (only from @cam; the planner always creeps)",
          "title": "Move"
        },
        "roll_deg": {
          "default": 0,
          "title": "Roll Deg",
          "type": "number"
        },
        "shake": {
          "default": false,
          "description": "@cam shake: a camera shake at the shot's first frame",
          "title": "Shake",
          "type": "boolean"
        },
        "speed": {
          "maximum": 1.0,
          "minimum": 0.05,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "angle",
        "move",
        "speed"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "music_stop",
            "music_start",
            "background_music",
            "low_hit",
            "whoosh",
            "pop",
            "bark"
          ],
          "title": "Kind",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "volume": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "frame",
        "kind"
      ],
      "title": "Cue",
      "type": "object"
    },
    "EndCard": {
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "description": "where the story ends (duration_frames): finish appends the silent end screen there for validate.END_SCREEN_S",
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "description": "its headline, \"Follow for more\" (finish adds the handles from library/settings.json)",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "text"
      ],
      "title": "EndCard",
      "type": "object"
    },
    "Extra": {
      "additionalProperties": false,
      "description": "non-cast stickman: a seeded runner or a crowd member with optional team costume/prop.",
      "properties": {
        "action": {
          "enum": [
            "cheer",
            "angry",
            "gasp",
            "salute",
            "neutral",
            "fight",
            "run"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "camera"
          ],
          "title": "Facing",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "headwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/Headwear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "crowd",
            "runner"
          ],
          "title": "Kind",
          "type": "string"
        },
        "legwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/Legwear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "props": {
          "items": {
            "$ref": "#/$defs/Prop"
          },
          "maxItems": 2,
          "title": "Props",
          "type": "array"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "target_group": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Group"
        },
        "top": {
          "anyOf": [
            {
              "$ref": "#/$defs/Top"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "description": "seeds the extra's look (top, hat, colours, runner number)",
          "minimum": 0,
          "title": "Variant",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Extra",
      "type": "object"
    },
    "FaceChange": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "enum": [
            "neutral",
            "happy",
            "cheer",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted",
            "worried",
            "dead",
            "smug",
            "proud",
            "love",
            "excited",
            "relieved",
            "laughing",
            "wink",
            "furious",
            "annoyed",
            "disgusted",
            "crying",
            "scared",
            "embarrassed",
            "jealous",
            "guilty",
            "confused",
            "thinking",
            "suspicious",
            "shocked",
            "deadpan",
            "bored",
            "facepalm_ready",
            "dizzy",
            "drunk",
            "knocked_out",
            "evil",
            "crazy",
            "blank",
            "sick",
            "determined"
          ],
          "title": "Expression",
          "type": "string"
        },
        "frame": {
          "description": "the face changes from this video frame on (the word that names the mood)",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        }
      },
      "required": [
        "frame",
        "expression"
      ],
      "title": "FaceChange",
      "type": "object"
    },
    "Headwear": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "description": "wardrobe id (\"id\" or a plain string accepted too): built in flat_cap, postman_cap, bowler, straw_hat, wide_hat, or a library headwear; none",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Headwear",
      "type": "object"
    },
    "ItemSwitch": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "description": "the state flips here (a short tween either side)",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "to": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "to"
      ],
      "title": "ItemSwitch",
      "type": "object"
    },
    "Legwear": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "description": "wardrobe id: built in shorts, ragged_shorts, trousers, or a library legwear; none",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Legwear",
      "type": "object"
    },
    "Prop": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "anyOf": [
            {
              "description": "degrees the held prop leans, like a clock hand with the top tipped away from the body: 0 upright, 90 level, 75 = half past two in the right hand",
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "this character's own angle; null: the prop's",
          "title": "Angle"
        },
        "hand": {
          "default": "right",
          "enum": [
            "left",
            "right"
          ],
          "title": "Hand",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Prop",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "title": "Actors",
          "type": "array"
        },
        "animals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Animal"
          },
          "title": "Animals",
          "type": "array"
        },
        "camera": {
          "$ref": "#/$defs/Camera"
        },
        "end_frame": {
          "description": "exclusive",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "extras": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Extra"
          },
          "title": "Extras",
          "type": "array"
        },
        "id": {
          "pattern": "^s[0-9]{2,}$",
          "title": "Id",
          "type": "string"
        },
        "items": {
          "default": [],
          "description": "@item World Items on stage (left out of story.json when there are none, so older plans keep their bytes)",
          "items": {
            "$ref": "#/$defs/ShotItem"
          },
          "title": "Items",
          "type": "array"
        },
        "mood": {
          "anyOf": [
            {
              "enum": [
                "tense",
                "dark",
                "flashback",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "@mood: scene lighting, fog and colour tone (left out of story.json when there is none); none: neutral",
          "title": "Mood"
        },
        "phrase_range": {
          "description": "[first, last] phrase indices into phrases.json, inclusive",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Phrase Range",
          "type": "array"
        },
        "set": {
          "description": "set preset name, e.g. office, street, room",
          "title": "Set",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "travel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Travel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "travel shot: the world scrolls past the actors"
        },
        "twist": {
          "default": false,
          "title": "Twist",
          "type": "boolean"
        },
        "vehicles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Vehicle"
          },
          "title": "Vehicles",
          "type": "array"
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weather"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "@weather (or the set's default_weather); none: clear"
        }
      },
      "required": [
        "id",
        "start_frame",
        "end_frame",
        "set",
        "phrase_range",
        "camera"
      ],
      "title": "Shot",
      "type": "object"
    },
    "ShotItem": {
      "additionalProperties": false,
      "description": "@item: a World Item (library/objects.json card) on stage for this shot, flying a path when start and end\ndiffer (@do <tag>: fly left | right)",
      "properties": {
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "default": "right",
          "enum": [
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "description": "the @item tag",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "enum": [
            "sky",
            "back",
            "mid",
            "stage"
          ],
          "title": "Layer",
          "type": "string"
        },
        "object": {
          "description": "the World Item it draws",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Object",
          "type": "string"
        },
        "riders": {
          "default": [],
          "description": "cast ids seated inside it (enter) for the whole shot, its seats in order",
          "items": {
            "type": "string"
          },
          "title": "Riders",
          "type": "array"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "none: the item's first state",
          "title": "State"
        },
        "switch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemSwitch"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "open / close: the state it turns to, and when"
        },
        "y": {
          "description": "height of its base (a sky / back card: its middle) in world units",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "object",
        "layer",
        "start_pos",
        "y"
      ],
      "title": "ShotItem",
      "type": "object"
    },
    "Speech": {
      "additionalProperties": false,
      "description": "one story.md cast line (\"kai: line\"): its words (phrases.json indices, inclusive) and who says them",
      "properties": {
