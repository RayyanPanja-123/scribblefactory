{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "a built-in action (ACTIONS: idle, walk, run, talk, point, react, wave, ride, stagger, lie, collapse, eat, give, receive, carry, carried, support, supported, cheer, angry, gasp) or a custom one from library/actions.json",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Action",
          "type": "string"
        },
        "cast_id": {
          "title": "Cast Id",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "expression": {
          "description": "neutral: the cast member's default_expression",
          "enum": [
            "neutral",
            "happy",
            "cheer",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted",
            "worried",
            "dead"
          ],
          "title": "Expression",
          "type": "string"
        },
        "faces": {
          "default": [],
          "description": "face changes inside the shot, in frame order: expression until the first, then each from its frame",
          "items": {
            "$ref": "#/$defs/FaceChange"
          },
          "title": "Faces",
          "type": "array"
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "camera"
          ],
          "title": "Facing",
          "type": "string"
        },
        "look": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the cast member's named look (@look), none: its own",
          "title": "Look"
        },
        "prop": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "eat / give: the prop eaten / handed over",
          "title": "Prop"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "give / receive: the other actor; carry / support: the actor carried / supported",
          "title": "Target"
        }
      },
      "required": [
        "cast_id",
        "action",
        "start_pos",
        "facing",
        "expression"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Animal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "run",
            "idle",
            "bark"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "dog",
          "title": "Kind",
          "type": "string"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "variant": {
          "enum": [
            "brown",
            "black",
            "tan",
            "white_patches"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Animal",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "wide",
            "medium",
            "close",
            "low",
            "high",
            "over_shoulder"
          ],
          "title": "Angle",
          "type": "string"
        },
        "move": {
          "enum": [
            "push_in",
            "pull_out",
            "truck_left",
            "truck_right",
            "crane_up",
            "crane_down"
          ],
          "title": "Move",
          "type": "string"
        },
        "roll_deg": {
          "default": 0,
          "title": "Roll Deg",
          "type": "number"
        },
        "speed": {
          "maximum": 1.0,
          "minimum": 0.05,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "angle",
        "move",
        "speed"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "music_stop",
            "music_start",
            "background_music",
            "low_hit",
            "whoosh",
            "pop",
            "bark"
          ],
          "title": "Kind",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "volume": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "frame",
        "kind"
      ],
      "title": "Cue",
      "type": "object"
    },
    "EndCard": {
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "description": "where the story ends (duration_frames): finish appends the silent end screen there for validate.END_SCREEN_S",
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "description": "its headline, \"Follow for more\" (finish adds the handles from library/settings.json)",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "text"
      ],
      "title": "EndCard",
      "type": "object"
    },
    "Extra": {
      "additionalProperties": false,
      "description": "non-cast stickman: a seeded runner or a crowd member with optional team costume/prop.",
      "properties": {
        "action": {
          "enum": [
            "cheer",
            "angry",
            "gasp",
            "neutral",
            "fight",
            "run"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "camera"
          ],
          "title": "Facing",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "headwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/Headwear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "crowd",
            "runner"
          ],
          "title": "Kind",
          "type": "string"
        },
        "legwear": {
          "anyOf": [
            {
              "$ref": "#/$defs/Legwear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "props": {
          "items": {
            "$ref": "#/$defs/Prop"
          },
          "maxItems": 2,
          "title": "Props",
          "type": "array"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "target_group": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Group"
        },
        "top": {
          "anyOf": [
            {
              "$ref": "#/$defs/Top"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "description": "seeds the extra's look (top, hat, colours, runner number)",
          "minimum": 0,
          "title": "Variant",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Extra",
      "type": "object"
    },
    "FaceChange": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "enum": [
            "neutral",
            "happy",
            "cheer",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted",
            "worried",
            "dead"
          ],
          "title": "Expression",
          "type": "string"
        },
        "frame": {
          "description": "the face changes from this video frame on (the word that names the mood)",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        }
      },
      "required": [
        "frame",
        "expression"
      ],
      "title": "FaceChange",
      "type": "object"
    },
    "Headwear": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "description": "wardrobe id (\"id\" or a plain string accepted too): built in flat_cap, postman_cap, bowler, straw_hat, wide_hat, or a library headwear; none",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Headwear",
      "type": "object"
    },
    "Legwear": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the accent ($accent layers) of a recolourable library item",
          "title": "Accent"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "default": "none",
          "description": "wardrobe id: built in shorts, ragged_shorts, trousers, or a library legwear; none",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Legwear",
      "type": "object"
    },
    "Prop": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "anyOf": [
            {
              "description": "degrees the held prop leans, like a clock hand with the top tipped away from the body: 0 upright, 90 level, 75 = half past two in the right hand",
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "this character's own angle; null: the prop's",
          "title": "Angle"
        },
        "hand": {
          "default": "right",
          "enum": [
            "left",
            "right"
          ],
          "title": "Hand",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Prop",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "title": "Actors",
          "type": "array"
        },
        "animals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Animal"
          },
          "title": "Animals",
          "type": "array"
        },
        "camera": {
          "$ref": "#/$defs/Camera"
        },
        "end_frame": {
          "description": "exclusive",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "extras": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Extra"
          },
          "title": "Extras",
          "type": "array"
        },
        "id": {
          "pattern": "^s[0-9]{2,}$",
          "title": "Id",
          "type": "string"
        },
        "phrase_range": {
          "description": "[first, last] phrase indices into phrases.json, inclusive",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Phrase Range",
          "type": "array"
        },
        "set": {
          "description": "set preset name, e.g. office, street, room",
          "title": "Set",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "travel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Travel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "travel shot: the world scrolls past the actors"
        },
        "twist": {
          "default": false,
          "title": "Twist",
          "type": "boolean"
        },
        "vehicles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Vehicle"
          },
          "title": "Vehicles",
          "type": "array"
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weather"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "@weather (or the set's default_weather); none: clear"
        }
      },
      "required": [
        "id",
        "start_frame",
        "end_frame",
        "set",
        "phrase_range",
        "camera"
      ],
      "title": "Shot",
      "type": "object"
    },
    "Strike": {
      "additionalProperties": false,
      "description": "@fx lightning: one bolt + a brief flash, at the first word of the line after the directive",
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cast id the bolt lands near; none: behind the stage",
          "title": "Target"
        }
      },
      "required": [
        "frame"
      ],
      "title": "Strike",
      "type": "object"
    },
    "Top": {
      "additionalProperties": false,
      "properties": {
        "accent_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "suit: the tie colour (no tie when null); dress: the wide hat's ribbon and flower; a library top: its $accent layers",
          "title": "Accent Color"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "none: the cast member's own top colour in a look, else the default top colour",
          "title": "Color"
        },
        "number": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chest number on a white bib",
          "title": "Number"
        },
        "style": {
          "default": "plain",
          "description": "the top's wardrobe id (\"id\" accepted too): built in plain, suit, tank, shirt, dress, or a library top",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
          "title": "Style",
          "type": "string"
        }
      },
      "title": "Top",
      "type": "object"
    },
    "Travel": {
      "additionalProperties": false,
      "properties": {
        "speed": {
          "description": "world scroll speed, units/s; actors run in place against it",
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "speed"
      ],
      "title": "Travel",
      "type": "object"
    },
    "Vehicle": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "arrive",
            "drive",
            "leave",
            "idle",
            "broken"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "car",
          "title": "Kind",
          "type": "string"
        },
        "riders": {
          "default": [],
          "description": "cast ids seated (actors with action ride, or wave/talk while riding)",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Riders",
          "type": "array"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "variant": {
          "enum": [
            "red",
            "green",
            "navy",
            "yellow"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Vehicle",
      "type": "object"
    },
    "Weather": {
      "additionalProperties": false,
      "description": "scene weather, drawn in ink by the engine (weather.js): fog behind the cast, the rest in front",
      "properties": {
        "intensity": {
          "default": "medium",
          "enum": [
            "light",
            "medium",
            "heavy"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rain",
            "snow",
            "fog",
            "wind",
            "storm"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Weather",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Cue"
      },
      "title": "Cues",
      "type": "array"
    },
    "duration_frames": {
      "minimum": 1,
      "title": "Duration Frames",
      "type": "integer"
    },
    "end_card": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "every part's closing screen (older story.json files may have none)"
    },
    "fps": {
      "const": 30,
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "height": {
      "default": 1920,
      "enum": [
        1920,
        1080
      ],
      "title": "Height",
      "type": "integer"
    },
    "lightning": {
      "default": [],
      "description": "@fx lightning strikes, by frame",
      "items": {
