{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "a built-in action (ACTIONS: idle, walk, run, talk, point, react, wave, ride, stagger, lie, collapse, eat, give, receive, carry, carried, support, supported, cheer, angry, gasp) or a custom one from library/actions.json",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Action",
          "type": "string"
        },
        "cast_id": {
          "title": "Cast Id",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "expression": {
          "description": "neutral: the cast member's default_expression",
          "enum": [
            "neutral",
            "happy",
            "sad",
            "angry",
            "surprised",
            "sleepy",
            "cheeky",
            "exhausted"
          ],
          "title": "Expression",
          "type": "string"
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "camera"
          ],
          "title": "Facing",
          "type": "string"
        },
        "look": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the cast member's named look (@look), none: its own",
          "title": "Look"
        },
        "prop": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "eat / give: the prop eaten / handed over",
          "title": "Prop"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "give / receive: the other actor; carry / support: the actor carried / supported",
          "title": "Target"
        }
      },
      "required": [
        "cast_id",
        "action",
        "start_pos",
        "facing",
        "expression"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Animal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "run",
            "idle",
            "bark"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "dog",
          "title": "Kind",
          "type": "string"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "variant": {
          "enum": [
            "brown",
            "black",
            "tan",
            "white_patches"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Animal",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "wide",
            "medium",
            "close",
            "low",
            "high",
            "over_shoulder"
          ],
          "title": "Angle",
          "type": "string"
        },
        "move": {
          "enum": [
            "push_in",
            "pull_out",
            "truck_left",
            "truck_right",
            "crane_up",
            "crane_down"
          ],
          "title": "Move",
          "type": "string"
        },
        "roll_deg": {
          "default": 0,
          "title": "Roll Deg",
          "type": "number"
        },
        "speed": {
          "maximum": 1.0,
          "minimum": 0.05,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "angle",
        "move",
        "speed"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "music_stop",
            "music_start",
            "low_hit",
            "whoosh",
            "pop",
            "bark"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "kind"
      ],
      "title": "Cue",
      "type": "object"
    },
    "EndCard": {
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "description": "shown from this frame to the end, over the last shot",
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "description": "e.g. \"Part 2 on my profile \ud83d\udc46\"",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "text"
      ],
      "title": "EndCard",
      "type": "object"
    },
    "Extra": {
      "additionalProperties": false,
      "description": "non-cast stickman: crowd (stands behind the stage in a mood) or runner (background runner); seeded look",
      "properties": {
        "action": {
          "enum": [
            "cheer",
            "angry",
            "gasp",
            "neutral",
            "run"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "camera"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "crowd",
            "runner"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "variant": {
          "description": "seeds the extra's look (top, hat, colours, runner number)",
          "minimum": 0,
          "title": "Variant",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Extra",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "title": "Actors",
          "type": "array"
        },
        "animals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Animal"
          },
          "title": "Animals",
          "type": "array"
        },
        "camera": {
          "$ref": "#/$defs/Camera"
        },
        "end_frame": {
          "description": "exclusive",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "extras": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Extra"
          },
          "title": "Extras",
          "type": "array"
        },
        "id": {
          "pattern": "^s[0-9]{2,}$",
          "title": "Id",
          "type": "string"
        },
        "phrase_range": {
          "description": "[first, last] phrase indices into phrases.json, inclusive",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Phrase Range",
          "type": "array"
        },
        "set": {
          "description": "set preset name, e.g. office, street, room",
          "title": "Set",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "travel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Travel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "travel shot: the world scrolls past the actors"
        },
        "twist": {
          "default": false,
          "title": "Twist",
          "type": "boolean"
        },
        "vehicles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Vehicle"
          },
          "title": "Vehicles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start_frame",
        "end_frame",
        "set",
        "phrase_range",
        "camera"
      ],
      "title": "Shot",
      "type": "object"
    },
    "Travel": {
      "additionalProperties": false,
      "properties": {
        "speed": {
          "description": "world scroll speed, units/s; actors run in place against it",
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "speed"
      ],
      "title": "Travel",
      "type": "object"
    },
    "Vehicle": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "arrive",
            "drive",
            "leave",
            "idle",
            "broken"
          ],
          "title": "Action",
          "type": "string"
        },
        "end_pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Pos"
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "car",
          "title": "Kind",
          "type": "string"
        },
        "riders": {
          "default": [],
          "description": "cast ids seated (actors with action ride, or wave/talk while riding)",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Riders",
          "type": "array"
        },
        "start_pos": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Pos",
          "type": "array"
        },
        "variant": {
          "enum": [
            "red",
            "green",
            "navy",
            "yellow"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "action",
        "start_pos",
        "facing",
        "variant"
      ],
      "title": "Vehicle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Cue"
      },
      "title": "Cues",
      "type": "array"
    },
    "duration_frames": {
      "minimum": 1,
      "title": "Duration Frames",
      "type": "integer"
    },
    "end_card": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "non-final parts only; the final part has none"
    },
    "fps": {
      "const": 30,
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "height": {
      "const": 1920,
      "default": 1920,
      "title": "Height",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "title": "Shots",
      "type": "array"
    },
    "width": {
      "const": 1080,
      "default": 1080,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "duration_frames",
    "seed",
    "shots"
  ],
  "title": "StoryModel",
  "type": "object"
}
