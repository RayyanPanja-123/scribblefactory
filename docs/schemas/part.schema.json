{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        }
      },
      "title": "Approval",
      "type": "object"
    },
    "Approvals": {
      "additionalProperties": false,
      "properties": {
        "final": {
          "$ref": "#/$defs/Approval",
          "default": {
            "approved_at": null
          }
        },
        "stills": {
          "$ref": "#/$defs/Approval",
          "default": {
            "approved_at": null
          }
        }
      },
      "title": "Approvals",
      "type": "object"
    },
    "Post": {
      "additionalProperties": false,
      "properties": {
        "posted_at": {
          "format": "date-time",
          "title": "Posted At",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "posted_at"
      ],
      "title": "Post",
      "type": "object"
    },
    "Posted": {
      "additionalProperties": false,
      "properties": {
        "instagram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Post"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "youtube": {
          "anyOf": [
            {
              "$ref": "#/$defs/Post"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Posted",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "inputs_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Hash"
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "while running: the process running it (a running stage whose process is gone was interrupted)",
          "title": "Pid"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "running",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Stage",
      "type": "object"
    },
    "Stages": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "finish": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "import_check": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "prep": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "render": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "shots": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "timing": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        },
        "tts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "voice_source tts only: voice.mp3 from the TTS server (none: never run)"
        },
        "validate": {
          "$ref": "#/$defs/Stage",
          "default": {
            "error": null,
            "finished_at": null,
            "inputs_hash": null,
            "pid": null,
            "started_at": null,
            "status": "pending"
          }
        }
      },
      "title": "Stages",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "$ref": "#/$defs/Approvals",
      "default": {
        "final": {
          "approved_at": null
        },
        "stills": {
          "approved_at": null
        }
      }
    },
    "id": {
      "pattern": "^part-[0-9]{2}$",
      "title": "Id",
      "type": "string"
    },
    "number": {
      "maximum": 99,
      "minimum": 1,
      "title": "Number",
      "type": "integer"
    },
    "posted": {
      "$ref": "#/$defs/Posted",
      "default": {
        "instagram": null,
        "youtube": null
      }
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stages": {
      "$ref": "#/$defs/Stages",
      "default": {
        "audio": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "finish": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "import_check": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "prep": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "render": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "shots": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "timing": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        },
        "validate": {
          "error": null,
          "finished_at": null,
          "inputs_hash": null,
          "pid": null,
          "started_at": null,
          "status": "pending"
        }
      }
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "voice_source": {
      "default": "recorded",
      "description": "recorded: an uploaded voice.mp3; tts: the tts stage makes voice.mp3 from the script",
      "enum": [
        "recorded",
        "tts"
      ],
      "title": "Voice Source",
      "type": "string"
    }
  },
  "required": [
    "id",
    "number",
    "title"
  ],
  "title": "PartModel",
  "type": "object"
}
