  "components": {
    "schemas": {
      "CastApproval": {
        "properties": {
          "cast_id": {
            "title": "Cast Id",
            "type": "string"
          }
        },
        "required": [
          "cast_id"
        ],
        "title": "CastApproval",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobRequest": {
        "properties": {
          "part": {
            "title": "Part",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "slug",
          "part",
          "steps"
        ],
        "title": "JobRequest",
        "type": "object"
      },
      "Posting": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "force": {
            "default": false,
            "title": "Force",
            "type": "boolean"
          },
          "platform": {
            "enum": [
              "youtube",
              "instagram"
            ],
            "title": "Platform",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "platform",
          "url"
        ],
        "title": "Posting",
        "type": "object"
      },
      "Thumbnail": {
        "properties": {
          "n": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "N",
            "type": "integer"
          }
        },
        "required": [
          "n"
        ],
        "title": "Thumbnail",
        "type": "object"
      },
      "UploadText": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "UploadText",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
