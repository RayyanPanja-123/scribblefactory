  "limits": [
    {
      "id": "flat-ground",
      "status": "partly lifted",
      "limit": "characters walk on flat ground; stairs and slopes only along a set's `trail` (`@do <cast>: climb`), one trail per set",
      "workaround": "put the stairs in a set with a trail; cut between levels for anything else"
    },
    {
      "id": "no-swimming",
      "status": "open",
      "limit": "no swimming, diving or flying: no free vertical movement, no depth, no underwater look",
      "workaround": "a water set (`water: true`) with characters standing, or cut to the surface; see 02-locomotion-modes.md"
    },
    {
      "id": "no-battle-structure",
      "status": "open",
      "limit": "no duel or battle choreography: one aimed custom action per attacker (`attack-with-spears <target>`), no parry, hit exchange or formation",
      "workaround": "two or three short lines, one strike each, victim reacts (`collapse` + `dead`); crowds fight with `@crowd <group> fight <other>`; see 03-interaction-choreography.md"
    },
    {
      "id": "one-action-per-line",
      "status": "workaround",
      "limit": "each cast member has one action per narration line (a long line is split into shots, an action happens in the first)",
      "workaround": "one beat per line; use `@do` on the line the beat happens"
    },
    {
      "id": "stage-size",
      "status": "workaround",
      "limit": "at most 6 in the front row and 12 on stage; walking needs free room",
      "workaround": "split the scene; use in-place actions with four or more on stage"
    },
    {
      "id": "own-art-only",
      "status": "workaround",
      "limit": "characters are the stickman rig only (humanoid, biped, bird, quadruped, crawler); no new body shapes without a library creature",
      "workaround": "add a creature to the library"
    },
    {
      "id": "no-collision",
      "status": "workaround",
      "limit": "characters do not collide: two climbing the same trail, or one walking through another, overlap",
      "workaround": "keep climbs and walks to one character at a time"
    },
    {
      "id": "camera-orbit-cap",
      "status": "workaround",
      "limit": "orbit arcs at most 45 degrees (the painted backdrop shows its edges beyond that)",
      "workaround": "chain an orbit with a cut"
    },
    {
      "id": "voice-locked",
      "status": "workaround",
      "limit": "narration words and timing are fixed once the voice is recorded: no new lines, `@pause` or `@pace` after",
      "workaround": "direct with `@do` / `@face` / `@cam` only"
    }
